{
  "realm": "ledgerx",
  "displayName": "LedgerX",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "ledgerx-operator",
        "description": "May provision wallet owners and inspect LedgerX operational evidence."
      }
    ]
  },
  "bruteForceProtected": true,
  "sslRequired": "external",
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "ledgerx-owner"
  ],
  "clientScopes": [
    {
      "name": "ledgerx-owner",
      "description": "Adds the admin-provisioned LedgerX wallet owner ID to signed tokens.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "ledgerx-owner-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ledgerx_owner_id",
            "claim.name": "ledgerx_owner_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "ledgerx-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ledgerx-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ledgerx-api",
      "name": "LedgerX API",
      "description": "Resource server audience. This client does not issue credentials.",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "ledgerx-web",
      "name": "LedgerX Workbench",
      "description": "Public browser client using authorization code and PKCE.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${LEDGERX_WEB_ORIGIN}/"],
      "webOrigins": ["${LEDGERX_WEB_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${LEDGERX_WEB_ORIGIN}/?signed-out=1"
      }
    }
  ]
}
