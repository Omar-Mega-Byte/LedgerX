# Deployment environment template. Copy to a private .env file only for tools that support dotenv.
# Do not commit .env. Spring Boot receives these values from the shell, secret manager, or container runtime.
# The defaults below are project-owned names for the self-hosted Docker Compose stack.
# Replace only the values explicitly marked CHANGE_ME before public deployment.

# Runtime
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL financial datastore. The Docker service is named postgres. LEDGERX_DB_PORT applies only
# to the local-development compose file; the production database has no host port.
LEDGERX_DB_NAME=ledgerx
LEDGERX_DB_URL=jdbc:postgresql://postgres:5432/ledgerx
LEDGERX_DB_USERNAME=ledgerx
LEDGERX_DB_PASSWORD=CHANGE_ME_LEDGERX_DATABASE_PASSWORD
LEDGERX_DB_PORT=5432

# Kafka stays on the private Docker network. Multiple brokers may be comma-separated later.
LEDGERX_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
LEDGERX_KAFKA_PAYMENT_EVENTS_TOPIC=ledgerx.payment-events.v1

# Production event delivery. Keep both enabled unless this deployment intentionally has no Kafka role.
LEDGERX_KAFKA_CONSUMER_ENABLED=true
LEDGERX_OUTBOX_PUBLISHER_ENABLED=true

# REQUIRED for the self-hosted Keycloak/OIDC stack. Keycloak owns JWT signing keys; LedgerX
# validates signed tokens with the issuer's published JWKS and does not need a JWT signing secret.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DATABASE_PASSWORD
KC_BOOTSTRAP_ADMIN_USERNAME=ledgerx-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
LEDGERX_OIDC_REALM=ledgerx
LEDGERX_OIDC_API_CLIENT_ID=ledgerx-api
LEDGERX_WEB_CLIENT_ID=ledgerx-web

# REQUIRED for public HTTPS deployment. Caddy obtains and renews certificates automatically only
# after both public DNS names resolve to this server and TCP 80/443 reach Caddy. The Keycloak
# hostname below is the one selected for this deployment. Register a separate API hostname before
# replacing LEDGERX_PUBLIC_DOMAIN, then set the issuer URI to the exact public Keycloak URL.
LEDGERX_PUBLIC_DOMAIN=CHANGE_ME_LEDGERX_API_DOMAIN
KEYCLOAK_PUBLIC_DOMAIN=ledgerx-auth-elrfaay.duckdns.org
LEDGERX_OIDC_ISSUER_URI=https://ledgerx-auth-elrfaay.duckdns.org/realms/ledgerx
CADDY_ACME_EMAIL=CHANGE_ME_CERTIFICATE_NOTIFICATION_EMAIL

# Outbox delivery tuning. These are the application defaults and are suitable for one server.
LEDGERX_OUTBOX_POLL_DELAY=PT5S
LEDGERX_OUTBOX_LEASE_DURATION=PT30S
LEDGERX_OUTBOX_PUBLISH_TIMEOUT=PT10S
LEDGERX_OUTBOX_BATCH_SIZE=20
LEDGERX_OUTBOX_RETRY_BASE_DELAY=PT1S
LEDGERX_OUTBOX_RETRY_MAX_DELAY=PT5M

# Signed merchant webhooks are opt-in. Replace the encryption placeholder with a base64-encoded
# 32-byte AES key from the deployment secret manager before enabling either worker.
LEDGERX_WEBHOOK_CONSUMER_ENABLED=false
LEDGERX_WEBHOOK_DISPATCHER_ENABLED=false
LEDGERX_WEBHOOK_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_AES_KEY
LEDGERX_WEBHOOK_ENCRYPTION_KEY_VERSION=1
LEDGERX_WEBHOOK_MAX_ENDPOINTS_PER_MERCHANT=5
LEDGERX_WEBHOOK_MAX_ATTEMPTS=8

# Read-only reconciliation records integrity findings without changing financial data.
LEDGERX_RECONCILIATION_ENABLED=false
