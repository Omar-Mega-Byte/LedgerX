# Copy this file to .env for tools that support dotenv files. Do not commit .env.
# Spring Boot itself receives environment variables from the shell, IDE, or container runtime.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local PostgreSQL defaults. These credentials are for development only.
LEDGERX_DB_NAME=ledgerx
LEDGERX_DB_USERNAME=ledgerx
LEDGERX_DB_PASSWORD=ledgerx_local_password
LEDGERX_DB_PORT=5432

# Future secret-bearing configuration must be supplied as environment variables.
# Example naming convention: LEDGERX_<AREA>_<SETTING>
# LEDGERX_AUTH_JWT_SECRET=replace-with-a-local-development-secret
